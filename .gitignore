# ------------------------------------------------------------
# Repo-wide ignore rules for the fMRI ageing dissertation project
# ------------------------------------------------------------

# Operating system noise
.DS_Store
Thumbs.db

# Editor / notebook local state
.vscode/
.ipynb_checkpoints/
tempCodeRunnerFile.py
.spyderproject
.spyproject
.ropeproject

# Python cache, test, and type-check artefacts
__pycache__/
*.py[codz]
*$py.class
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.hypothesis/
.tox/
.nox/
.cache/

# Local environments and secrets
.env
.envrc
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.pdm-python
.pdm-build/
.pixi/
__pypackages__/
.streamlit/secrets.toml
*.key
license.txt

# Packaging / compiled artefacts
build/
dist/
.eggs/
*.egg
*.egg-info/
MANIFEST
*.so

# Logs and temporary files
logs/
*.log
*.tmp
*.pid
*.rdb
*.aof

# Documentation build output
docs/_build/
site/

# Tool-specific local folders
.abstra/
marimo/_static/
marimo/_lsp/
__marimo__/

# Neuroimaging data and heavy binary outputs
# This repository is treated as a code/manuscript repo by default, so local
# data products stay ignored unless explicitly added on purpose.
data/
derivatives/
work/
fmriprep/
sourcedata/
*.nii
*.nii.gz
*.mgz
*.gii
*.h5
*.hdf5

# Participant-level metadata folders that should not be added casually
phenotype/

# Accidental nested local copy of the repo
fMRI-Network-Segregation-Aging/

# Local working-note files that are not part of the public repo snapshot
docs/analysis_results_traceability_notes.md
docs/repo_notes.md

# Dissertation folder policy
# Track only manuscript source files by default.
# Ignore compiled LaTeX output and helper/build files unless explicitly unignored later.
dissertation/**
!dissertation/
!dissertation/**/
!dissertation/**/*.tex
!dissertation/references.bib
